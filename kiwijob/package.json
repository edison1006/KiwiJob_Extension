{
  "name": "kiwijob",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-rollup-native.cjs && npm run build -w @kiwijob/shared",
    "dev:web": "npm run dev -w @kiwijob/web",
    "dev:extension": "npm run dev -w @kiwijob/extension",
    "build:web": "npm run build -w @kiwijob/web",
    "build:extension": "npm run build -w @kiwijob/extension",
    "package:extension": "npm run package -w @kiwijob/extension",
    "build:shared": "npm run build -w @kiwijob/shared",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:extension": "npm run typecheck -w @kiwijob/extension",
    "typecheck": "npm run typecheck:web && npm run typecheck:extension",
    "ci": "npm run build:shared && npm run typecheck && npm run build:web && npm run package:extension && cd apps/api && python3 -m pytest -q"
  }
}
