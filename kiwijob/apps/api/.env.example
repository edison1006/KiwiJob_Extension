ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/kiwijob?sslmode=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_ADDON_CLIENT_ID=
GOOGLE_WORKSPACE_ADDON_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_ADDON_AUDIENCE=https://your-api-domain.com/integrations/gmail-addon
WEB_APP_URL=https://your-dashboard-domain.com
API_PUBLIC_URL=https://your-api-domain.com
APPLE_OAUTH_CLIENT_ID=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=20160
SECURE_AUTH_COOKIE=true
CORS_ORIGINS=https://your-dashboard-domain.com,chrome-extension://your-extension-id
CORS_ORIGIN_REGEX=
RESUME_STORAGE_DIR=./data/resumes
RESUME_S3_BUCKET=your-private-resume-bucket
RESUME_MAX_BYTES=10485760
RATE_LIMIT_ENABLED=true
CAREER_SYNC_ENABLED=true
CAREER_SYNC_INTERVAL_SECONDS=60
CAREER_SYNC_BATCH_SIZE=100
CAREER_SYNC_CONCURRENCY=10
