{
  "name": "@kiwijob/extension",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "icons": "python3 scripts/render_icons.py",
    "build": "vite build && node ./scripts/bundle-extension.mjs",
    "package": "npm run build && node ./scripts/package-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kiwijob/shared": "file:../../packages/shared",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.5",
    "vite": "^8.2.0"
  }
}
